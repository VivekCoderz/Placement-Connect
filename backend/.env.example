# PlacementConnect backend configuration.
# Copy to backend/.env and fill in real values. Never commit backend/.env.
# Placeholder values only below.

# ---- Runtime ----
NODE_ENV=development            # production on the deployed server
PORT=5000
# Number of reverse proxies in front of the app (Render/Railway/Nginx: 1). Used for
# correct client IPs in rate limiting. Leave 0 for local development.
TRUST_PROXY=0

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/placementconnect-dev
# Legacy name, still read if MONGO_URI is unset:
# mongoURI=

# ---- Auth (REQUIRED: the server refuses to start without JWT_SECRET) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=1d

# ---- Account security (optional) ----
# Wrong passwords allowed before an account is locked, and for how long (minutes).
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15

# ---- Continue with Google (optional; the Google button is hidden when unset) ----
# OAuth 2.0 "Web application" client id from Google Cloud Console > APIs & Services >
# Credentials. Add your frontend URLs (http://localhost:5173 and the deployed one) under
# "Authorized JavaScript origins". Must match VITE_GOOGLE_CLIENT_ID in frontend/.env.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ---- CORS / links ----
# Comma-separated exact origins of the frontend (no trailing slash). The first one is
# also used to build password-reset links. localhost:5173/3000 are allowed automatically
# when NODE_ENV is not "production".
CLIENT_URL=https://your-frontend.example.com
# Legacy name, still read and merged with CLIENT_URL:
# FRONTEND_URL=

# ---- Cloudinary (resume / offer letter / profile picture uploads) ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Legacy names, still read if the CLOUDINARY_* ones are unset:
# cloud_name=
# api_key=
# api_secret=

# ---- Email (any SMTP provider: Brevo, Resend SMTP, Gmail app password, ...) ----
# If SMTP_HOST/SMTP_USER/SMTP_PASS are missing, emails are skipped with a warning.
SMTP_HOST=smtp-relay.example.com
SMTP_PORT=587
SMTP_SECURE=false               # true for port 465
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM='"Geeta University Placement Cell" <placements@example.com>'

# ---- Rate limits (optional; requests per 15 minutes per IP) ----
AUTH_RATE_LIMIT=20
PASSWORD_RESET_RATE_LIMIT=5

# ---- One-off scripts (only needed when running them) ----
# npm run seed:admin  -> creates the first admin account
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use-a-long-unique-password
# npm run seed:demo   -> DESTRUCTIVE demo seed, local development only
SEED_PASSWORD=demo-password-for-local-only

# ---- AI resume screening ----
# Engines are tried in order: Gemini (if GEMINI_API_KEY is set), Ollama (if OLLAMA_URL is
# set), then a built-in rules engine that always works.
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: model names (defaults are aliases Google keeps pointed at current models)
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Optional: a self-hosted Ollama server, e.g. http://127.0.0.1:11434
# OLLAMA_URL=
# OLLAMA_MODEL=qwen2.5:3b
# Per-request AI timeout in milliseconds
# AI_TIMEOUT_MS=20000
